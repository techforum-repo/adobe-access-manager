# =========================================================
# Adobe Access Manager
# Environment Configuration
#
# Every line below maps to a field in adobe_access/config.py's Settings
# class. Anything not listed here has no effect on the app.
# =========================================================

# -----------------------------
# Application
# -----------------------------
APP_ENV=development

# -----------------------------
# Mode switches — see README "Modes" and "Production readiness checklist"
# -----------------------------
MOCK_ADOBE=true
ADOBE_WRITE_ENABLED=false

# -----------------------------
# User validation
# -----------------------------
ALLOWED_EMAIL_DOMAINS=example.com
DEFAULT_COUNTRY=US
DEFAULT_IDENTITY_TYPE=federatedID

# -----------------------------
# Adobe IMS (technical account / OAuth Server-to-Server)
# Required only when MOCK_ADOBE=false.
# -----------------------------
ADOBE_ORG_ID=
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_SCOPES=openid,AdobeID,user_management_sdk
ADOBE_IMS_TOKEN_URL=https://ims-na1.adobelogin.com/ims/token/v3

# -----------------------------
# Adobe User Management API
# -----------------------------
ADOBE_UMAPI_BASE_URL=https://usermanagement.adobe.io/v2/usermanagement

# HTTP timeout (seconds) for every Adobe call. Raise this if you're behind a
# slow corporate proxy and see "Adobe request timed out" errors.
ADOBE_HTTP_TIMEOUT=60

# -----------------------------
# Caching
# -----------------------------
# Seconds before the Dashboard flags the group cache as stale. Also
# editable at runtime from the in-app Settings page (no restart needed).
CACHE_TTL_SECONDS=600
